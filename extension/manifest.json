{
  "manifest_version": 2,
  "name": "YTM Together",
  "version": "1.0.3",
  "description": "Listen to YouTube Music together in tight sync — host-led playback with automatic drift correction.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ytm-together@ytm-together.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["sync-core.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["sync-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "YTM Together",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  }
}
